<Ui>
    <!--
        BENILLA_ALLOW_OWN_UI=1 — the one adapter the reference's own PetActionBarFrame.xml needs
        from this engine (decision 1953; 1751 §2 keeps an adapter for exactly a genuine engine
        difference).

        The autocast shine. The reference's `$parentAutoCast` on every pet button is a <Model>
        playing `Interface\Buttons\UI-AutoCastButton.mdx`, setAllPoints on the 30x30 button at
        scale 1.2, shown and hidden by its own `PetActionBar_Update` (PetActionBarFrame.lua
        l.135-139). This engine's <Model> holds the scene the Lua API reads and writes and draws no
        pixels (`script/modelframe.rs`); the shine benilla draws is its own lane — the
        `benilla:autocast-shine:<scale>` token texture (decisions 1383/1387, `autocast_shine.rs`),
        which reads the model's OWN tracks out of the shipped .m2. So each button gets a Shine
        texture over its whole rect carrying the reference's own 1.2, and the reference's
        `PetActionBar_Update` is wrapped to carry the shine with the model.

        Nothing else. The reference's file is sourced unedited: its Models exist and are harmless.
    -->
    <Script><![CDATA[
        for i = 1, NUM_PET_ACTION_SLOTS do
            local button = getglobal("PetActionButton" .. i)
            local shine = button:CreateTexture("PetActionButton" .. i .. "Shine", "OVERLAY")
            shine:SetTexture("benilla:autocast-shine:1.2")
            shine:SetAllPoints(button)
            shine:Hide()
        end

        local reference_PetActionBar_Update = PetActionBar_Update
        function PetActionBar_Update()
            reference_PetActionBar_Update()
            for i = 1, NUM_PET_ACTION_SLOTS do
                local model = getglobal("PetActionButton" .. i .. "AutoCast")
                local shine = getglobal("PetActionButton" .. i .. "Shine")
                if model:IsShown() then
                    shine:Show()
                else
                    shine:Hide()
                end
            end
        end
    ]]></Script>
</Ui>
