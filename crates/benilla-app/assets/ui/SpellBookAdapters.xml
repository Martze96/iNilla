<Ui>
    <!--
        BENILLA_ALLOW_OWN_UI=1 — the one adapter the reference's own SpellBookFrame.xml needs from
        this engine (decision 1952; 1751 §2 keeps an adapter for exactly a genuine engine difference).

        The pet page's autocast shine. The reference's `$parentAutoCast` on every SpellButton is a
        <Model> playing `Interface\Buttons\UI-AutoCastButton.mdx` (36x36, CENTER (1,1), scale 1.22),
        shown and hidden by its own `SpellButton_UpdateButton` (SpellBookFrame.lua l.367-377). This
        engine's <Model> holds the scene the Lua API reads and writes and draws no pixels
        (`script/modelframe.rs`); the shine benilla draws is its own lane — the
        `benilla:autocast-shine:<scale>` token texture (decisions 1383/1392, `autocast_shine.rs`),
        which reads the model's OWN tracks out of the shipped .m2. So each SpellButton gets a Shine
        texture beside the model, at the numbers 1393 squared onto this button (37x37 CENTER (0,0),
        scale 1.48 — the reference's 36x36 CENTER (1,1) at 1.22, one ratio each, recorded there), and
        the reference's SpellButton_UpdateButton is wrapped to carry the shine with the model.

        1393's other number rides along for the same reason: the bracket overlay is 71.53 rather
        than the reference's 60, so the art — which fills 33/64 of UI-AutoCastableOverlay.blp —
        lands on this button's corners at the pet button's own 0.997x.

        Nothing else. The reference's file is sourced unedited: its Models exist and are harmless.
    -->
    <Script><![CDATA[
        for i = 1, 12 do
            local button = getglobal("SpellButton" .. i)
            local overlay = getglobal("SpellButton" .. i .. "AutoCastable")
            overlay:SetWidth(71.53)
            overlay:SetHeight(71.53)
            local shine = button:CreateTexture("SpellButton" .. i .. "Shine", "OVERLAY")
            shine:SetTexture("benilla:autocast-shine:1.48")
            shine:SetWidth(37)
            shine:SetHeight(37)
            shine:SetPoint("CENTER", button, "CENTER", 0, 0)
            shine:Hide()
        end

        local reference_SpellButton_UpdateButton = SpellButton_UpdateButton
        function SpellButton_UpdateButton()
            reference_SpellButton_UpdateButton()
            if not this then
                return
            end
            local name = this:GetName()
            local model = getglobal(name .. "AutoCast")
            local shine = getglobal(name .. "Shine")
            if model and shine then
                if model:IsShown() then
                    shine:Show()
                else
                    shine:Hide()
                end
            end
        end
    ]]></Script>
</Ui>
